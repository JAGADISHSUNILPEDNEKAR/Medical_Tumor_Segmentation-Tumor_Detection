# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend (browser-reachable API origin). Leave empty to use same-origin / Vite proxy.
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Backend CORS — comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model loading (unused until a real checkpoint is registered)
MODEL_PATH=
MODEL_VERSION=

# Storage and metadata (Phase 2)
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
DATABASE_URL=sqlite:///./data/app.db
MAX_UPLOAD_SIZE_MB=500

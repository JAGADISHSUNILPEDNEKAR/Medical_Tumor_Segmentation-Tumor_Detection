# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend (browser-reachable API origin). Leave empty to use same-origin / Vite proxy.
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Backend CORS — comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Inference backend (Phase 6)
#   mock    — synthetic geometric segmentation, no checkpoint, no PyTorch needed
#   pytorch — the trained 3D U-Net; requires MODEL_PATH and the torch dependency
INFERENCE_BACKEND=mock

# Path to the trained checkpoint exported by the training notebook
# (experiments/run_<id>/best_model.pth). Required when INFERENCE_BACKEND=pytorch.
MODEL_PATH=

# Optional. When empty, the service derives a version from the checkpoint's
# own SHA-256 prefix and recorded epoch rather than inventing one.
MODEL_VERSION=

# auto | cpu | cuda | cuda:0 — "auto" uses CUDA when present, otherwise CPU.
# A GPU is never required for the API to start.
INFERENCE_DEVICE=auto

# Refuse a checkpoint whose recorded model/patch/preprocessing fingerprint does
# not match this service's reconstruction. Does NOT relax state_dict loading,
# which is always strict.
INFERENCE_STRICT_FINGERPRINT=true

# Storage and metadata (Phase 2)
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
DATABASE_URL=sqlite:///./data/app.db
MAX_UPLOAD_SIZE_MB=500

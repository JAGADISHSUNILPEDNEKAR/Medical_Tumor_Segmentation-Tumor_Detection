FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY backend/requirements.txt /app/requirements.txt

# Install the CPU-only torch wheel explicitly. Left to PyPI's default, `torch`
# resolves to the CUDA build on linux/amd64, which adds multiple GB of NVIDIA
# runtime libraries this image cannot use. For a GPU deployment, start from a
# CUDA base image and drop this line so requirements.txt pulls the CUDA build.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/scripts /app/scripts

COPY backend/app /app/app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

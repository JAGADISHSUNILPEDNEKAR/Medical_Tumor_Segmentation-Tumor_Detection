FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY backend/requirements.txt /app/requirements.txt

# Install the CPU-only torch wheel explicitly. Left to PyPI's default, `torch`
# resolves to the CUDA build on linux/amd64, which adds multiple GB of NVIDIA
# runtime libraries this image cannot use. For a GPU deployment, start from a
# CUDA base image and drop this line so requirements.txt pulls the CUDA build.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/scripts /app/scripts

COPY backend/app /app/app

RUN groupadd -r appuser && useradd -r -g appuser appuser
# The upload/results directories will be mounted as a volume at /data, 
# but we create them here with permissions so the appuser can write to them 
# even if the volume mount fails or is empty initially.
RUN mkdir -p /data/uploads /data/results /data/tmp /models && chown -R appuser:appuser /app /data /models

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

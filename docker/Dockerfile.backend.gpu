# UNTESTED GPU DEPLOYMENT TEMPLATE
# This is a template for GPU deployment. It requires a host with NVIDIA drivers
# and the nvidia-container-toolkit installed.

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Install python and pip
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.11 /usr/bin/python

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY backend/requirements.txt /app/requirements.txt

# Install PyTorch with CUDA support.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/scripts /app/scripts
COPY backend/app /app/app

RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN mkdir -p /data/uploads /data/results /data/tmp /models && chown -R appuser:appuser /app /data /models

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
